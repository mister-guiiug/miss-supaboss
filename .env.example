# ── Serveur Miss Supaboss ──────────────────────────────────────────────
# Port d'écoute de l'API (et du front en production).
SUPABOSS_PORT=8787
# Hôte d'écoute (0.0.0.0 en Docker).
SUPABOSS_HOST=127.0.0.1
# Répertoire des données persistantes (SQLite + clé maître auto-générée).
SUPABOSS_DATA_DIR=./data
# Clé maître AES-256-GCM (base64, 32 octets) chiffrant les PAT au repos.
# Si absente : générée au premier démarrage dans $SUPABOSS_DATA_DIR/master.key.
# Générer : node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# SUPABOSS_MASTER_KEY=
# Compte admin créé au premier démarrage (mot de passe généré et affiché
# en console si SUPABOSS_ADMIN_PASSWORD est absent).
SUPABOSS_ADMIN_EMAIL=admin@local
# SUPABOSS_ADMIN_PASSWORD=
# Mode mock serveur : provider Supabase simulé, aucun appel réseau sortant.
# SUPABOSS_MOCK=1
# Cookies Secure (mettre 1 derrière HTTPS — recommandé en production).
# SUPABOSS_SECURE_COOKIES=1
# Budget d'appels Management API par compte et par minute (limite doc : 60).
SUPABOSS_API_BUDGET_PER_MIN=50

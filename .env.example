# ── Serveur Miss Supaboss ──────────────────────────────────────────────
# Port d'écoute de l'API (et du front en production).
SUPABOSS_PORT=8787
# Hôte d'écoute (0.0.0.0 en Docker).
SUPABOSS_HOST=127.0.0.1
# Répertoire des données persistantes (SQLite + clé maître auto-générée).
SUPABOSS_DATA_DIR=./data
# Clé maître AES-256-GCM (base64, 32 octets) chiffrant les PAT au repos.
# Si absente : générée au premier démarrage dans $SUPABOSS_DATA_DIR/master.key.
# Générer : node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# SUPABOSS_MASTER_KEY=
# Compte admin créé au premier démarrage (mot de passe généré et affiché
# en console si SUPABOSS_ADMIN_PASSWORD est absent).
SUPABOSS_ADMIN_EMAIL=admin@local
# SUPABOSS_ADMIN_PASSWORD=
# Mode mock serveur : provider Supabase simulé, aucun appel réseau sortant.
# SUPABOSS_MOCK=1
# Cookies Secure (mettre 1 derrière HTTPS — recommandé en production).
# SUPABOSS_SECURE_COOKIES=1
# Budget d'appels Management API par compte et par minute (limite doc : 60).
SUPABOSS_API_BUDGET_PER_MIN=50
# Synchro de fond (minutes) : statuts de la flotte (Management API seule),
# puis alertes (fin de fenêtre de restauration). 0 la coupe : les alertes ne
# partent plus qu'aux synchros déclenchées par l'app.
SUPABOSS_SYNC_INTERVAL_MIN=15
# 1 : la synchro de fond collecte AUSSI les quotas, donc les alertes de seuil
# partent sans que personne ouvre l'app. Désactivé par défaut : la collecte
# interroge la BASE de chaque projet actif, et rien ne documente si Supabase
# la compte comme de l'activité (ce qui retarderait sa mise en pause).
# SUPABOSS_SYNC_METRICS=1
# Contact VAPID transmis aux services push (mailto: ou https:). Défaut :
# mailto:<SUPABOSS_ADMIN_EMAIL>. Les clés VAPID elles-mêmes sont engendrées
# au premier démarrage et scellées en base : rien à fournir.
# SUPABOSS_VAPID_SUBJECT=mailto:ops@example.org
# Secours : désactive la double authentification de cet e-mail au démarrage
# (téléphone ET codes de secours perdus). À retirer une fois reconnecté.
# SUPABOSS_TOTP_RESET=admin@local
# 1 : autorise les webhooks vers le réseau INTERNE du serveur (boucle locale,
# réseau privé, lien local…) — pour un ntfy auto-hébergé sur le réseau local.
# Désactivé par défaut : c'est le serveur qui appelle l'URL, et TOUT compte,
# même en lecture seule, pourrait alors s'en servir pour sonder ce réseau.
# Sans effet sur le Web Push, dont les services sont toujours publics.
# SUPABOSS_WEBHOOK_ALLOW_PRIVATE=1

# ── Front (build Vite, préfixe VITE_) ──────────────────────────────────
# Build PWA (GitHub Pages, sans backend) : impose le mode démo/local-first.
# VITE_MOCK=1
# Proxy CORS de la Supabase Management API (cf. proxy/ — Cloudflare Worker).
# Renseigné UNIQUEMENT sur le build PWA pour activer le mode RÉEL local-first :
# la PWA interroge alors Supabase via ce relais (le PAT reste sur l'appareil).
# Sans cette variable, la PWA reste en démo (mock).
# VITE_SUPABASE_PROXY=https://supaboss-management-proxy.<sous-domaine>.workers.dev
# Observabilité front : DSN Sentry (optionnel). Vide = désactivé (no-op).
# VITE_SENTRY_DSN=

# Clé de projet PostHog (`phc_…`), nuage EUROPÉEN — la MÊME pour tout le parc :
# un seul projet, les applications distinguées dedans par `app_name`, que le
# socle déduit du chemin de base. Publique par conception (elle est dans le
# bundle). Absente, le bandeau de consentement ne rend rien et rien n'est
# mesuré — c'est le seul interrupteur.
VITE_POSTHOG_KEY=
